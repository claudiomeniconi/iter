{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/claudiomeniconi/iter/schema/procedura.schema.json",
  "title": "Procedura Iter",
  "type": "object",
  "required": [
    "id",
    "modello",
    "titolo",
    "territorio",
    "versione",
    "ultima_verifica",
    "enti",
    "passaggi"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+$"
    },
    "modello": {
      "type": "string",
      "description": "Famiglia della procedura, uguale in tutti i territori (es. somministrazione.apertura). Serve a confrontare lo stesso iter tra comuni diversi."
    },
    "titolo": {
      "type": "string"
    },
    "descrizione": {
      "type": "string"
    },
    "territorio": {
      "type": "object",
      "required": [
        "livello",
        "nome",
        "percorso"
      ],
      "properties": {
        "livello": {
          "enum": [
            "nazionale",
            "regionale",
            "provinciale",
            "comunale"
          ]
        },
        "nome": {
          "type": "string"
        },
        "codice_istat": {
          "type": "string"
        },
        "percorso": {
          "type": "string",
          "pattern": "^it(/[a-z0-9-]+)*$",
          "description": "Percorso nell'albero dei territori, es. it/toscana/ar/montevarchi"
        }
      }
    },
    "categoria": {
      "type": "string"
    },
    "stato": {
      "enum": [
        "bozza",
        "pubblicata",
        "archiviata"
      ]
    },
    "versione": {
      "type": "string"
    },
    "ultima_verifica": {
      "type": "string",
      "format": "date"
    },
    "domande": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "testo",
          "tipo"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "testo": {
            "type": "string"
          },
          "tipo": {
            "enum": [
              "si_no",
              "scelta",
              "numero"
            ]
          },
          "opzioni": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "enti": {
      "type": "array",
      "description": "Riferimenti al registro enti in data/enti",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          }
        }
      }
    },
    "passaggi": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/passaggio"
      }
    }
  },
  "$defs": {
    "fonte": {
      "type": "object",
      "required": [
        "titolo",
        "verificata_il"
      ],
      "properties": {
        "titolo": {
          "type": "string"
        },
        "riferimento": {
          "type": "string",
          "description": "Es. art. 19 L. 241/1990"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "verificata_il": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "documento": {
      "type": "object",
      "required": [
        "id",
        "nome"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Identificativo stabile, uguale tra enti diversi"
        },
        "nome": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "passaggio": {
      "type": "object",
      "required": [
        "id",
        "titolo",
        "tipo",
        "ente",
        "fonti"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "titolo": {
          "type": "string"
        },
        "tipo": {
          "enum": [
            "presentazione",
            "autorizzazione",
            "pagamento",
            "requisito",
            "iscrizione",
            "comunicazione",
            "controllo",
            "attesa"
          ]
        },
        "ente": {
          "type": "string",
          "description": "id di un ente del registro data/enti"
        },
        "attore": {
          "enum": [
            "richiedente",
            "professionista",
            "ente"
          ]
        },
        "documenti_richiesti": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/documento"
          }
        },
        "documenti_prodotti": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/documento"
          }
        },
        "costi": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "voce"
            ],
            "properties": {
              "voce": {
                "type": "string"
              },
              "min_euro": {
                "type": "number",
                "minimum": 0
              },
              "max_euro": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        },
        "tempi": {
          "type": "object",
          "properties": {
            "previsto_giorni": {
              "type": "number",
              "minimum": 0
            },
            "reale_giorni": {
              "type": "number",
              "minimum": 0
            },
            "reale_segnalazioni": {
              "type": "integer",
              "minimum": 0
            },
            "silenzio_assenso": {
              "type": "boolean"
            }
          }
        },
        "dipende_da": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "condizioni": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "domanda",
              "valore"
            ],
            "properties": {
              "domanda": {
                "type": "string"
              },
              "valore": {}
            }
          }
        },
        "canale": {
          "enum": [
            "online",
            "sportello",
            "pec",
            "misto"
          ]
        },
        "fonti": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/fonte"
          }
        },
        "livello_fonte": {
          "enum": [
            "ue",
            "stato",
            "regione",
            "comune_regolamento",
            "comune_atto",
            "prassi",
            "non_trovato"
          ],
          "description": "Livello della norma che impone il passaggio: dice subito chi può toglierlo o snellirlo (Iter Lab). prassi = richiesto dall'ufficio senza norma che lo imponga; non_trovato = base normativa non ancora individuata"
        },
        "stato_verifica": {
          "enum": [
            "bozza",
            "verificato_fonti",
            "verificato_ente"
          ],
          "description": "bozza = da confermare; verificato_fonti = controllato sulle fonti ufficiali; verificato_ente = confermato dall'ente o da un professionista"
        },
        "note": {
          "type": "string"
        }
      }
    }
  }
}
